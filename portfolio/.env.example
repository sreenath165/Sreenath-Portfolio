# Groq API Key (required for chatbot)
# Get your key at: https://console.groq.com
# In production, set this in Vercel Environment Variables (Settings > Environment Variables)
GROQ_API_KEY=your_groq_api_key_here

# Resend API Key (required for contact form emails)
# Get your key at: https://resend.com/api-keys
# In production, set this in Vercel Environment Variables
RESEND_API_KEY=your_resend_api_key_here
